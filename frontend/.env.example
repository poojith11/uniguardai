# ==============================================================================
# UNIGUARD AI - Frontend Environment Configuration Template
# Instructions: Configure these in your deployment platform (e.g. Vercel) or .env.local
# NEVER commit actual secrets to version control.
# ==============================================================================

# Backend API Endpoint
# In local development: http://127.0.0.1:8000
# In production: https://uniguard-ai-backend.onrender.com
VITE_BACKEND_URL=https://your-backend-deployment-url.com

# Supabase Client Configuration (Public Anon Key is safe in frontend)
# Obtain from: https://supabase.com/dashboard/project/<your-project-id>/settings/api
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
